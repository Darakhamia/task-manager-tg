# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_WEBHOOK_SECRET=my-random-secret-string-here

# Server
BASE_URL=https://yourdomain.com
PORT=3000

# Optional: comma-separated Telegram chat IDs that are allowed to use the bot
# Leave empty or remove to allow all
ALLOWED_CHAT_IDS=

# Optional: path to store user data (default: ./data)
DATA_DIR=./data

# Optional: debug | info | warn | error
LOG_LEVEL=info

# NOTE: OpenAI API Key, Notion Token, and Notion Database ID are now
# configured per-user through the Telegram bot onboarding flow (/start).
